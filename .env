# APPLICATION CONFIG
NEXT_PUBLIC_APP_URL=https://shindapesa-web.vercel.app
NEXT_PUBLIC_API_URL=https://shindapesa-web.onrender.com

# M-PESA API CONFIGURATION
# Set to 'production' for live api, 'sandbox' for test api
MPESA_ENV=production

# Your Lipa Na M-Pesa (C2B) Credentials
# For Paybill: Shortcode is your Paybill number
# For Till (Buy Goods): Store Number is the "Shortcode" and Till Number is the "PartyB"
MPESA_CONSUMER_KEY=W74YsCs7sBn34GXxf7EacuVou44vbTN6JxKUt7AXyIstwgh7
MPESA_CONSUMER_SECRET=RCiVqjfRBoyd9pSyWfZR0IQxApLM36ijl44ILTak4PBarg8coR928AKFBVqJHrky
MPESA_PASSKEY=a6a89fa8a33aaffe9751ee7288c225 5d7bb55b72cd0c12ea6536d152cc6a4747

# TRANSACTION TYPE
# Defaulting to 'CustomerBuyGoodsOnline' for your Till setup
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# SHORTCODES
# For your Till number: 8733762
MPESA_TILL_NUMBER=8733762
# IMPORTANT: Provide your Store Number below (The 'Shortcode' associated with your Till)
MPESA_STORE_NUMBER=4706070
MPESA_SHORTCODE=3700945

# CALLBACKS
# Publicly accessible URL for Safaricom to send payment notifications
MPESA_CALLBACK_URL=https://shindapesa-web.onrender.com/api/mpesa/callback

# B2C (WITHDRAWALS) CONFIGURATION
# Only needed if you plan to send money back to users
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_CALLBACK_URL=https://shindapesa-web.onrender.com/api/mpesa/withdraw-callback
